# Dependencias
/node_modules

# Archivo de Entorno
.env

# Config local de opencode (con MCPs y credenciales que no van al repo)
opencode.json
/.opencode/

# Imagenes de prueba subidas via el endpoint de drones (no son assets del repo)
uploads/imagen-*

# Carpeta de fuentes locales para el seed de imagenes (no se commitea)
/uploads/dron_modelos/

# Snapshot estatico de la landing page (regenerado en cada deploy con `npm run snapshot`)
/frontend/assets/data/landing-snapshot.json

# Lockfiles alternativos (el proyecto usa npm)
pnpm-lock.yaml
yarn.lock

# Archivos de logs de NPM
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos del sistema operativo
.DS_Store
Thumbs.db